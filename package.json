{
  "name": "tennis-performance-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "site": "node scripts/run-dev.mjs",
    "dev": "npm run site",
    "dev:3006": "npm run site",
    "dev:turbo": "next dev --turbopack -H 127.0.0.1 -p 3006",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "start:3005": "next start -H 127.0.0.1 -p 3005",
    "start:3006": "next start -H 127.0.0.1 -p 3006",
    "start:3007": "next start -H 127.0.0.1 -p 3007",
    "stop:3006": "bash scripts/stop-3006.sh",
    "restart:3006": "node scripts/free-port.mjs 3006 && npm run build && npm run start:3006",
    "lint": "next lint"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-navigation-menu": "^1.2.3",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.171.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
